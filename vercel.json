{
  "redirects": [
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/tt",
      "destination": "/?utm_source=tiktok&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/in",
      "destination": "/?utm_source=linkedin&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/x",
      "destination": "/?utm_source=x&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/bsky",
      "destination": "/?utm_source=bluesky&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/fb",
      "destination": "/?utm_source=facebook&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/yt",
      "destination": "/?utm_source=youtube&utm_medium=social&utm_campaign=bio",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
